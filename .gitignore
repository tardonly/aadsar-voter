# Allow-list: ignore everything in this folder, then let through only what the app needs.
# This keeps the PDFs, Excel files, plain voter data (app-build/voters.json) and
# app-build/PASSWORDS.txt out of git even if new files are added later.
/*

!/.gitignore

# the website Vercel serves (contains only encrypted data, no passwords)
!/voter-search-app/

# build script and instructions, but nothing else from app-build
!/app-build/
/app-build/*
!/app-build/encrypt.mjs
!/app-build/README.md

.DS_Store
